# ============================================================
#  AgroGuard AI - Backend environment template
#  Copy this file to `.env` and fill in your own values.
#    cp .env.example .env
# ============================================================

# ---- Flask server ----
HOST=0.0.0.0
PORT=5000
FLASK_DEBUG=0

# ---- MongoDB ----
MONGO_URI=mongodb://localhost:27017/
MONGO_DB=agroguard_db

# ---- Model Confidence Thresholds ----
# Plant validation threshold (0.0 to 1.0)
# Images below this threshold will be rejected as unsupported/uncertain
PLANT_CONFIDENCE_THRESHOLD=0.50

# Disease classification threshold (0.0 to 1.0)
# Predictions below this threshold will be marked as uncertain
DISEASE_CONFIDENCE_THRESHOLD=0.50
