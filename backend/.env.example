# ============================================================
#  AgroGuard AI - Backend environment template
#  Copy this file to `.env` and fill in your own values.
#    cp .env.example .env
# ============================================================

# ---- Flask server ----
HOST=0.0.0.0
PORT=5000
FLASK_DEBUG=0

# ---- MongoDB ----
MONGO_URI=mongodb://localhost:27017/
MONGO_DB=agroguard_db

# ---- Weather API ----
# Open-Meteo is free and keyless. Set OPENWEATHER_API_KEY only if you switch
# to the OpenWeatherMap integration.
OPENWEATHER_API_KEY=
GEOCODING_API_URL=https://geocoding-api.open-meteo.com/v1/search
WEATHER_API_URL=https://api.open-meteo.com/v1/forecast
